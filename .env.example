# ── Embeddings ────────────────────────────────────────────────────────────────
# Прив'язані до бази — не змінювати після першої індексації!
EMBEDDING_PROVIDER=openai          # openai | local (local = bge-m3, поки не реалізовано)
OPENAI_API_KEY=sk-...

# ── LLM (генерація) ──────────────────────────────────────────────────────────
# Можна вільно перемикати між провайдерами
LLM_PROVIDER=openai                # openai | openrouter
OPENROUTER_API_KEY=                # потрібен лише при LLM_PROVIDER=openrouter
LLM_MODEL=gpt-4o-mini              # або будь-яка модель OpenRouter

# ── Шляхи ─────────────────────────────────────────────────────────────────────
# Відносно директорії backend/
HTML_DIR=./data/instructions
CHROMA_DIR=./data/chroma
