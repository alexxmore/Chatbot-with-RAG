# ── Embeddings ────────────────────────────────────────────────────────────────
# Прив'язані до бази — не змінювати після першої індексації!
EMBEDDING_PROVIDER=openai          # openai | local (local = bge-m3, поки не реалізовано)
OPENAI_API_KEY=sk-...

# ── LLM (генерація) ──────────────────────────────────────────────────────────
# Можна вільно перемикати між провайдерами
LLM_PROVIDER=openai                # openai | openrouter
OPENROUTER_API_KEY=                # потрібен лише при LLM_PROVIDER=openrouter
LLM_MODEL=gpt-4o-mini              # або будь-яка модель OpenRouter

# ── Шляхи ─────────────────────────────────────────────────────────────────────
# Відносно директорії backend/
HTML_DIR=./data/instructions
CHROMA_DIR=./data/chroma

# ── Пошук (retrieval) ────────────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.70           # косинусна відстань; калібрується tools/calibrate_threshold.py
DENSE_POOL=20                      # к-сть dense-кандидатів до RRF-злиття
BM25_POOL=20                       # к-сть BM25-кандидатів до RRF-злиття

# ── Логування ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs                     # JSON-lines → logs/app.log (ротація)
LOG_PROMPTS=false                  # true → у лог /chat додається обрізане прев'ю повідомлення
