control=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;1&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;6e5f0db5-0927-4c0e-ab9c-68e9cccd5eb6&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;margin-left&amp;#58;0px;text-align&amp;#58;center;&quot;&gt;ІТ послуга&amp;#58; Підтримка модуля «Сумовий облік»&lt;/h2&gt;&lt;p&gt;Сервіс, що забезпечує точне відображення, контроль і узгодження фінансових сум у всіх пов’язаних системах, своєчасне виявлення розбіжностей та підтримання достовірності бухгалтерської і управлінської звітності.&amp;#160;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;2&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;6b23a0bb-1e4c-4ce5-946d-7512a699aeac&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;lineHeight1_2&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;Перелік активів&lt;/h2&gt;&lt;ul class=&quot;customListStyle&quot;&gt;&lt;li data-list-item-id=&quot;e08fcdbf65d692704c5bcc4ba407c0653&quot;&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; data-text-type=&quot;noSpacing&quot;&gt;&lt;strong&gt;DWH,&amp;#160;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;ed6ee52646ff1ecdf954cb9b5c8bd4c3a&quot;&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; data-text-type=&quot;noSpacing&quot;&gt;&lt;strong&gt;SAP,&amp;#160;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;e92d338e91188942a16f557800511fe97&quot;&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; data-text-type=&quot;noSpacing&quot;&gt;&lt;strong&gt;ПЗ FZClient.&amp;#160;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;3&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;91fc1e44-0071-48d8-adc2-80f4308513e3&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;Які питання вирішує послуга&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;- АЗС&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Звірка по АЗС&lt;/p&gt;&lt;p&gt;(Пере)завантаження агрегатів-документів&lt;/p&gt;&lt;p&gt;Помилка проведення агрегату&lt;/p&gt;&lt;p&gt;Тара. Звірка з постачальником&lt;/p&gt;&lt;p&gt;Акт звірки по тарі&lt;/p&gt;&lt;p&gt;Коригування боргів по тарі&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- САП&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Створити пакетник для відміни вирівнювань /причина 03 чи 04/&lt;/p&gt;&lt;p&gt;Невірний код податку в документі&lt;/p&gt;&lt;p&gt;- Документи&amp;#58;&lt;/p&gt;&lt;p&gt;Повернути в статус Новий&lt;/p&gt;&lt;p&gt;Не завантажено в СО&lt;/p&gt;&lt;p&gt;Не завантажено в САП&lt;/p&gt;&lt;p&gt;Не проводиться документ&lt;/p&gt;&lt;p&gt;Невідповідність суми Рубікон/ДВХ/Фауст/Аннона/САП/СО&lt;/p&gt;&lt;p&gt;Тр.повернення, відсутній зв&#39;язаний трансферт&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- Товарний облік (зміна ціни, ПДВ, дати)&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Зміна цін&lt;/p&gt;&lt;p&gt;Зміна ставки ПДВ&lt;/p&gt;&lt;p&gt;Зміна бух. дати (дати проводки) в СО&lt;/p&gt;&lt;p&gt;Зміна дати документа (постачальника) в СО&lt;/p&gt;&lt;p&gt;Зміна дати проводки в Рубікон/ДВХ/Фауст/Аннона/СО&lt;/p&gt;&lt;p&gt;DWH. Перерахунок СКЦ&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- Договори&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Зміна договорів в СО&lt;/p&gt;&lt;p&gt;Зміна договорів в Аннона/ДВХ/Рубікон/Фауст/СО&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- Залишки&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Обнулити залишки на закритій філії (1 філія)&lt;/p&gt;&lt;p&gt;Обнулити залишки по закритим артикулам (1 філія)&lt;/p&gt;&lt;p&gt;Пересорт по тарі (звичайна/зворотна)&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- Сторно&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Сторнувати документ (дата більше 3-х місяців)&lt;/p&gt;&lt;p&gt;Сторнувати документ, який відсутній в СО&lt;/p&gt;&lt;p&gt;Сторнувати документ датою проведення&lt;/p&gt;&lt;p&gt;Помилка при сторнації&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- Рахунки ГК&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Змінити рахунок ГК в документах&lt;/p&gt;&lt;p&gt;Внести зміни у довідник ГК&lt;/p&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;noSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;- ОСВ&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Не закриваються рахунки М15*, 23*, 63*&lt;/p&gt;&lt;p&gt;Невідповідність ОСВ в СУ і в САП&amp;#160;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;4&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;2fcf71eb-cfd5-4848-8580-a20a271ddf41&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;Примітки&lt;/h2&gt;&lt;p class=&quot;noSpacingAbove noSpacingBelow&quot; data-text-type=&quot;noSpacing&quot;&gt;Терміни виконання звернень поданих в межах цього шаблону складають до 5х робочих днів (без врахування вихідних) та обробляються фахівцями підтримки тільки в бізнес час.&lt;br&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;5&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;b4622e1b-2174-45ca-8bf4-4b354bb47fe7&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;text-align&amp;#58;center;&quot;&gt;Часті питання&lt;/h2&gt;&lt;h4&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;1.Що робити, якщо необхідно виправити залишки у звіті «Акт звірки по тарі»?&lt;/span&gt;&lt;/h4&gt;&lt;p&gt;Необхідно скористатись функціоналом FZClient модуль «Створення документів», звіт «Коригування боргів по тарі» та створити документи коригування.&lt;/p&gt;&lt;p aria-hidden=&quot;true&quot;&gt;&amp;#160;&lt;/p&gt;&lt;h4 class=&quot;headingSpacingAbove headingSpacingBelow&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;2.Що робити, якщо при спробі повернути документ у попередній статус документ зависає в статусі «Очікування переводу в попередній статус» з червоним значком?&amp;#160;&lt;/span&gt;&lt;/span&gt;&amp;#160;&lt;/h4&gt;&lt;p&gt;Через контекстне меню вибрати «Стан» і переглянути причину помилки. Якщо причиною помилки є наявність вирівнювань («Документ вже містить вирівняні позиції - сторнування неможливе»), то необхідно їх зняти і повторити операцію над документом переводу в попередній статус ще раз.&amp;#160;&lt;br&gt;Якщо причиною помилки є «В даний момент заблоковано користувачем» необхідно звернутись до вказаного користувача або почекати і повторити операцію над документом переводу в попередній статус ще раз.&amp;#160;&lt;br&gt;&amp;#160;&lt;/p&gt;&lt;h4 class=&quot;headingSpacingAbove headingSpacingBelow&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;3.Що робити, якщо при проведенні документу не змінює статус з Новий на Проведений?&amp;#160;&lt;/span&gt;&lt;/span&gt;&amp;#160;&lt;/h4&gt;&lt;p&gt;Необхідно перевірити чи проставлений рахунки ГК (автовибір рахунку або ручний вибір рахунку) і повторити операцію проведення документа повторно.&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;h4 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;4.Що робити, якщо документ відсутній в СО&lt;/span&gt;?&lt;/span&gt;&lt;/h4&gt;&lt;p&gt;Необхідно перевірити дату проведення документу. Якщо дата проведення поточна дата, то документ буде завантажено в СО на наступний день після нічного перерахунку.&lt;/p&gt;&lt;p aria-hidden=&quot;true&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;&lt;strong&gt;5.Що робити, якщо при спробі сторнувати документ, документ випадає в помилку «Очікування сторнування» з червоним значком?&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Через контекстне меню вибрати «Стан» і переглянути причину помилки. Якщо причиною помилки є наявність вирівнювань, то необхідно їх зняти і повторити операцію сторнування над документом ще раз&amp;#58; у контекстному меню вибрати «Виконати сторно». Якщо дана кнопка відсутня – необхідно подати заявку на надання доступу до цього функціоналу.&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;&lt;strong&gt;6.Що робити, якщо не закривається рахунок М15*?&amp;#160;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Необхідно перевірити, чи є документи у статусі «Новий» або «Очікування сторно». Після проведення цих документів перевірити М15*.&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;&lt;strong&gt;7.Що робити, якщо потрібно обнулити залишки на закритій філії, на філії на реконструкції, тимчасово закритій філії або закриті артикули?&amp;#160;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Необхідно в першу чергу перевірити залишки в Рубікон. Якщо залишки наявні – їх потрібно обнулити. Для виконання обнулення на стороні Рубікон необхідно звернутися до аналітиків.&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;&lt;strong&gt;8.Що робити, якщо в сумовому обліку в звіті залишки на дату по рахункам, які не відносяться до рахунків по товару в дорозі, по артикулам в розрізі складів наявні залишки які потрібно згорнути між складами?&amp;#160;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Необхідно спочатку перевірити залишки в Рубікон і при наявності – їх згорнути в Рубікон. Для виконання обнулення на стороні Рубікон необхідно звернутися до аналітиків.&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; aria-hidden=&quot;true&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;span class=&quot;fontSizeLarge&quot;&gt;&lt;span style=&quot;background-color&amp;#58;rgb(255, 255, 255);color&amp;#58;rgb(41, 42, 46);&quot;&gt;&lt;strong&gt;9.Що робити, якщо необхідно сторнувати документ поточною датою (сьогодні)?&amp;#160;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Необхідно звернутися до аналітиків або подати стандартне звернення через шаблон на виправлення помилок в товарному обліку.&amp;#160;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;6&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;ceb5f189-8d72-4895-a35c-5417ad2f0e5e&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;4,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;contentVersion&amp;quot;&amp;#58;5&amp;#125;&quot;&gt;&lt;div data-sp-rte=&quot;&quot;&gt;&lt;h2 class=&quot;headingSpacingAbove headingSpacingBelow&quot; style=&quot;margin-left&amp;#58;0px;text-align&amp;#58;center;&quot;&gt;Реєстрація звернення Підтримка модуля «Сумовий облік»&amp;#160;&lt;/h2&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;strong&gt;Де знайти шаблон звернення “Підтримка модуля «Сумовий облік»”?&lt;/strong&gt;&lt;/p&gt;&lt;ul class=&quot;customListStyle&quot;&gt;&lt;li data-list-item-id=&quot;e5bc502be242085bf6edb85770ad1cdae&quot;&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;Шлях до звернення на ресурсі &lt;a href=&quot;https&amp;#58;//servicedesk.fozzy.lan/&quot;&gt;https&amp;#58;//servicedesk.fozzy.lan/&lt;/a&gt; → Операційна діяльність → Підтримка модулів, програмне забезпечення → Підтримка модуля «Сумовий облік». Або за посиланням внизу сторінки.&amp;#160;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;&amp;#160;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;eb4f18050603028ea9659078e20481de6&quot;&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot; data-text-type=&quot;withSpacing&quot;&gt;&lt;strong&gt;Для реєстрації запиту, необхідно в шаблоні звернення&amp;#58;&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;ea0c61c9ae04bc876666a83043541a81a&quot;&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot; data-text-type=&quot;withSpacing&quot;&gt;В полі “Запитується для” вписати або через “+” обрати з переліку ПІБ колеги, якщо створюєте звернення не для себе. Якщо звернення стосується лише Вас, тоді лишаєте поле без змін.&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;e22259d1faca124d8b00e7d01ce2ca8bd&quot;&gt;&lt;p&gt;Оберіть Юридичну особу з випадаючого списку.&lt;/p&gt;&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;e3a4aed005f2b09474d57ef7695197cdf&quot;&gt;&lt;p&gt;У полі Категорія потрібно обрати пункт, з яким у вас виникли труднощі&amp;#58;&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- АЗС&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Договори&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Документи&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Залишки&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Інше&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- ОСВ&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Рахунки ГК&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- САП&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Сторно&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Тара. Звірка з постачальником&lt;/p&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; data-text-type=&quot;withSpacing&quot;&gt;- Товарний облік (зміна ціни, ПДВ, дати).&amp;#160;&lt;/p&gt;&lt;/li&gt;&lt;li data-list-item-id=&quot;ed7acf46c0a921426a981cb9d09d37da5&quot;&gt;Важливо! Просимо додавати номери документів у вкладення до звернення файлом.&lt;/li&gt;&lt;li data-list-item-id=&quot;e4e6d0904c2219af404594a44ef6fd21e&quot;&gt;&lt;p class=&quot;noSpacingAbove spacingBelow&quot; style=&quot;margin-left&amp;#58;0px;&quot; data-text-type=&quot;withSpacing&quot;&gt;Натисніть “Підтвердити” - і звернення зареєстровано. Чекайте на зворотній зв&#39;язок від ServiceDesk.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-sp-canvascontrol=&quot;&quot; data-sp-canvasdataversion=&quot;1.0&quot; data-sp-controldata=&quot;&amp;#123;&amp;quot;position&amp;quot;&amp;#58;&amp;#123;&amp;quot;layoutIndex&amp;quot;&amp;#58;1,&amp;quot;zoneIndex&amp;quot;&amp;#58;2,&amp;quot;zoneId&amp;quot;&amp;#58;&amp;quot;27418be5-0c40-4173-bdc3-f33a48baa266&amp;quot;,&amp;quot;sectionIndex&amp;quot;&amp;#58;1,&amp;quot;sectionFactor&amp;quot;&amp;#58;12,&amp;quot;controlIndex&amp;quot;&amp;#58;7&amp;#125;,&amp;quot;id&amp;quot;&amp;#58;&amp;quot;23537c9d-28fa-4443-b58f-25488066067d&amp;quot;,&amp;quot;controlType&amp;quot;&amp;#58;3,&amp;quot;isFromSectionTemplate&amp;quot;&amp;#58;false,&amp;quot;addedFromPersistedData&amp;quot;&amp;#58;true,&amp;quot;webPa